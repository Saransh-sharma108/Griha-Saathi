{
  "name": "griha-saathi",
  "version": "1.0.0",
  "description": "Griha Saathi - Trustworthy Rental Housing Platform for Bharat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm.cmd run dev:all",
    "dev:all": "concurrently \"npm.cmd run dev:server\" \"npm.cmd run dev:client\"",
    "dev:client": "vite --config vite.config.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "start": "node server/src/index.js",
    "build": "npm.cmd run build:client && npm.cmd run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "test:auth": "tsx server/src/tests/auth.test.ts",
    "test:search": "tsx server/src/tests/search.test.ts",
    "test:demo-search": "tsx client/src/data/demoProperties.test.ts",
    "test:listing": "tsx server/src/tests/listing.test.ts",
    "test:verification": "tsx server/src/tests/verification.test.ts",
    "test:connections": "tsx server/src/tests/connections_messaging_visits.test.ts",
    "test:ai": "tsx server/src/tests/saathi_ai.test.ts",
    "test:dashboard": "tsx server/src/tests/dashboard_notifications_account.test.ts",
    "test:homedna": "tsx server/src/tests/homedna.test.ts",
    "test:e2e": "tsx server/src/tests/e2e_integration_security.test.ts",
    "test:real-data": "tsx server/src/tests/real_property_data_engine.test.ts",
    "test": "npm.cmd run test:auth && npm.cmd run test:search && npm.cmd run test:listing && npm.cmd run test:verification && npm.cmd run test:connections && npm.cmd run test:ai && npm.cmd run test:dashboard && npm.cmd run test:homedna && npm.cmd run test:e2e && npm.cmd run test:real-data"
  },
  "keywords": [
    "rental",
    "housing",
    "india",
    "proptech",
    "verification",
    "trust"
  ],
  "author": "Griha Saathi Architecture Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^1.59.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
