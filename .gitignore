# ==============================================================================
# GRIHA SAATHI — OFFICIAL VERSION CONTROL IGNORE RULES (.gitignore)
# ==============================================================================

# 1. Dependency Directories
node_modules/
*/node_modules/

# 2. Environment Variables & Secrets (CRITICAL: Never commit active keys)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# 3. Production Build Artifacts & Distribution Bundles
client/dist/
server/dist/
dist/
build/
out/

# 4. TypeScript & Vite Cache Artifacts
*.tsbuildinfo
.vite/
.eslintcache
.cache/
.temp/
.tmp/

# 5. Diagnostic Scratch Scripts & Temporary Logs
scratch/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Uploaded User Documents & Transient Property Media
# Retain directory structure with .gitkeep while excluding private uploads
uploads/photos/*
!uploads/photos/.gitkeep
uploads/documents/*
!uploads/documents/.gitkeep

# 7. Operating System & Local Desktop Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 8. Local IDE & Editor Configurations
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
