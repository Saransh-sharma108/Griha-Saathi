# ==============================================================================
# GRIHA SAATHI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Note: Keep secrets private. Never commit active keys or secrets to version control.
# ==============================================================================

# Node Environment & Port Configuration
NODE_ENV=development
PORT=5000
VITE_API_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://grihasaathi.in

# Security & Session Secrets
# Generate random 32+ character strings for production deployments
SESSION_SECRET=YOUR_SECURE_SESSION_SECRET_MIN_32_CHARS
JWT_SECRET=YOUR_SECURE_JWT_SECRET_MIN_32_CHARS

# ------------------------------------------------------------------------------
# 1. Real Email Delivery Configuration (Nodemailer SMTP / Resend)
# Used for live email OTP registration, PIN recovery, and security alerts.
# Requires SPF, DKIM, and DMARC verification on your sender domain.
# ------------------------------------------------------------------------------
# Standard SMTP (AWS SES, SendGrid, Mailgun, Postmark, Google Workspace SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
EMAIL_FROM="Griha Saathi Security <noreply@grihasaathi.in>"

# Alternative: Resend HTTP API (https://resend.com)
RESEND_API_KEY=YOUR_RESEND_API_KEY

# ------------------------------------------------------------------------------
# 2. Telecom Carrier SMS Delivery Configuration (Twilio / MSG91)
# Used for live SMS OTP registration and PIN recovery to Indian mobile numbers.
# For Indian telecom delivery (DLT compliance): requires registered Principal Entity
# ID and TRAI DLT approved template headers under the Telecom Commercial Communications
# Customer Preference Regulations (TCCCPR).
# ------------------------------------------------------------------------------
# Option A: Twilio Global / India SMS Gateway
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+1234567890

# Option B: TRAI-DLT Registered Carrier SMS Gateway (MSG91 / Fast2SMS)
SMS_GATEWAY_PROVIDER=msg91
SMS_GATEWAY_API_KEY=YOUR_SMS_API_KEY
SMS_GATEWAY_SENDER_ID=GRHSAT
SMS_DLT_TEMPLATE_ID=1107161829000012345

# ------------------------------------------------------------------------------
# 3. Production Relational Database (PostgreSQL)
# Target schema documented in docs/database_schema.sql and docs/phase3_auth_migration.sql
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://griha_user:secure_password@localhost:5432/griha_saathi_db?sslmode=prefer

# ------------------------------------------------------------------------------
# 4. Authoritative Identity Verification (DigiLocker / UIDAI Gateway)
# Requires authorized DigiLocker Requester Organization status.
# ------------------------------------------------------------------------------
DIGILOCKER_CLIENT_ID=YOUR_DIGILOCKER_CLIENT_ID
DIGILOCKER_CLIENT_SECRET=YOUR_DIGILOCKER_CLIENT_SECRET
DIGILOCKER_REDIRECT_URI=https://grihasaathi.in/api/verifications/digilocker/callback

# ------------------------------------------------------------------------------
# 5. State Land Records & Revenue Registry Integrations (Target Regions)
# Authoritative APIs cross-referencing ownership titles and mutation records.
# ------------------------------------------------------------------------------
# Haryana (Jamabandi / Web-HALRIS - Directorate of Land Records Haryana)
HARYANA_JAMABANDI_API_URL=https://jamabandi.nic.in/api/v1
HARYANA_JAMABANDI_API_KEY=YOUR_HARYANA_JAMABANDI_API_KEY

# Punjab (Punjab Land Records Society - PLRS Fard Kendra)
PUNJAB_PLRS_ENDPOINT=https://plrs.org.in/api/v1
PUNJAB_PLRS_API_KEY=YOUR_PUNJAB_PLRS_API_KEY

# Delhi (Delhi Online Registration Information System - DORIS / DDA Bhoomi)
DELHI_REVENUE_API_URL=https://doris.delhigovt.nic.in/api/v1
DELHI_DORIS_API_KEY=YOUR_DELHI_DORIS_API_KEY

# Himachal Pradesh (Himbhoomi Land Records - Department of Revenue HP)
HP_HIMBHOOMI_API_URL=https://lpr.hp.nic.in/api/v1
HP_HIMBHOOMI_API_KEY=YOUR_HP_HIMBHOOMI_API_KEY

# Jammu & Kashmir (Aapki Zameen Aapki Nigrani - Revenue Department J&K)
JK_LAND_RECORDS_API_URL=https://landrecords.jk.gov.in/api/v1
JK_LAND_RECORDS_API_KEY=YOUR_JK_LAND_RECORDS_API_KEY

# ------------------------------------------------------------------------------
# 6. Central Electronic Registry (CERSAI - Equitable Mortgage Checks)
# Prevents fraudulent subleasing of bank-encumbered or sealed properties.
# ------------------------------------------------------------------------------
CERSAI_INSTITUTION_ID=YOUR_CERSAI_INSTITUTION_ID
CERSAI_API_SECRET=YOUR_CERSAI_API_SECRET
CERSAI_PUBLIC_KEY=YOUR_CERSAI_PUBLIC_KEY

# ------------------------------------------------------------------------------
# 7. Saathi AI Intelligent Assistant (Google Gemini API)
# Powers natural language understanding, multilingual comprehension, and
# verified tenancy law guidance with strict zero-hallucination guardrails.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY

# ------------------------------------------------------------------------------
# 8. Cloud Object Storage (AWS S3 / Cloudflare R2 / MinIO)
# Optional in development (defaults to local secure filesystem in /uploads).
# Strongly recommended for multi-instance production environments.
# ------------------------------------------------------------------------------
# AWS S3 Option:
AWS_REGION=ap-south-1
AWS_S3_BUCKET=YOUR_S3_BUCKET_NAME
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Cloudflare R2 Option:
# R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
# R2_BUCKET=YOUR_R2_BUCKET_NAME
# R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
