{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Griha Saathi Development Server",
      "type": "shell",
      "command": ".\\start.cmd",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Verify Server Health",
      "type": "shell",
      "command": "node scratch/verify_http.cjs",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Run Full Test Suite",
      "type": "shell",
      "command": "npm.cmd test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
